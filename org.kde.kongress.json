{
    "id": "org.kde.kongress",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.10",
    "sdk": "org.kde.Sdk",
    "command": "kongress",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--device=dri",
        "--share=network",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.kde.Solid.PowerManagement",
        "--own-name=org.kde.kongressac",
        "--filesystem=xdg-download",
        "--persist=path"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig",
        "/metatypes",
        "/share/qlogging-categories6"
    ],
    "modules": [
        {
            "name": "kopeninghours",
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DBUILD_WITH_QT6=ON"
            ],
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.1/src/kopeninghours-26.08.1.tar.xz",
                    "sha256": "f12736f88b840c5b644de130c6ee2e75a6af68ace97abfde698b5cd88639ee1a",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/kopeninghours-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "recast",
            "config-opts": [
                "-DBUILD_SHARED_LIBS=OFF",
                "-DRECASTNAVIGATION_DEMO=OFF",
                "-DRECASTNAVIGATION_EXAMPLES=OFF",
                "-DRECASTNAVIGATION_TESTS=OFF",
                "-DCMAKE_POSITION_INDEPENDENT_CODE=ON",
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
            ],
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/recastnavigation/recastnavigation/archive/refs/tags/v1.6.0.tar.gz",
                    "sha256": "d48ca0121962fa0639502c0f56c4e3ae72f98e55d88727225444f500775c0074",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 379780,
                        "stable-only": true,
                        "url-template": "https://github.com/recastnavigation/recastnavigation/archive/refs/tags/v$version.tar.gz"
                    }
                }
            ],
            "cleanup": [
                "/lib"
            ]
        },
        {
            "name": "kosmindoormap",
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DCMAKE_DISABLE_FIND_PACKAGE_Protobuf=TRUE"
            ],
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.1/src/kosmindoormap-26.08.1.tar.xz",
                    "sha256": "91e8e2767409e21923167deea598f45cdd65520f54f7a18c9e6e6d7b97fa60b8",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/kosmindoormap-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "kongress",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.1/src/kongress-26.08.1.tar.xz",
                    "sha256": "2c25912b18a18bb0f4a764f06bdbbd392b9f8b40aae122e379e76421941176df",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 242860,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/kongress-$version.tar.xz"
                    }
                }
            ]
        }
    ]
}
