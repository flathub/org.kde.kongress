{
    "id": "org.kde.kongress",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.10",
    "sdk": "org.kde.Sdk",
    "command": "kongress",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--device=dri",
        "--share=network",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.kde.Solid.PowerManagement",
        "--own-name=org.kde.kongressac",
        "--filesystem=xdg-download",
        "--persist=path"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig",
        "/metatypes",
        "/share/qlogging-categories6"
    ],
    "modules": [
        {
            "name": "kopeninghours",
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DBUILD_WITH_QT6=ON"
            ],
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.0/src/kopeninghours-26.08.0.tar.xz",
                    "sha256": "b53e954f60bdebcfff1e5744b1ca62cd96065f01b25eff8f9976c75b1827862c",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/kopeninghours-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "recast",
            "config-opts": [
                "-DBUILD_SHARED_LIBS=OFF",
                "-DRECASTNAVIGATION_DEMO=OFF",
                "-DRECASTNAVIGATION_EXAMPLES=OFF",
                "-DRECASTNAVIGATION_TESTS=OFF",
                "-DCMAKE_POSITION_INDEPENDENT_CODE=ON",
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
            ],
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/recastnavigation/recastnavigation/archive/refs/tags/v1.6.0.tar.gz",
                    "sha256": "d48ca0121962fa0639502c0f56c4e3ae72f98e55d88727225444f500775c0074",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 379780,
                        "stable-only": true,
                        "url-template": "https://github.com/recastnavigation/recastnavigation/archive/refs/tags/v$version.tar.gz"
                    }
                }
            ],
            "cleanup": [
                "/lib"
            ]
        },
        {
            "name": "kosmindoormap",
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DCMAKE_DISABLE_FIND_PACKAGE_Protobuf=TRUE"
            ],
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.0/src/kosmindoormap-26.08.0.tar.xz",
                    "sha256": "c37e3f537f12964f3aeecc9e2acf7e59618afc230a3c69ca02d53507099f7761",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/kosmindoormap-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "kongress",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.0/src/kongress-26.08.0.tar.xz",
                    "sha256": "10de05185351cf7f23d74f6fd98d7d30343acdbe9eabce6b5b8b33cfcd1dfb34",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 242860,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/kongress-$version.tar.xz"
                    }
                }
            ]
        }
    ]
}
