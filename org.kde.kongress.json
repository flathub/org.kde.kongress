{
    "id": "org.kde.kongress",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "kongress",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--device=dri",
        "--share=network",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.kde.Solid.PowerManagement",
        "--own-name=org.kde.kongressac",
        "--filesystem=xdg-download",
        "--persist=path"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig",
        "/metatypes",
        "/share/qlogging-categories6"
    ],
    "modules": [
        {
            "name": "kopeninghours",
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DBUILD_WITH_QT6=ON"
            ],
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.3/src/kopeninghours-26.08.3.tar.xz",
                    "sha256": "0d785277e38bf37e1bed5d85749c48f7fc228a3f94b995236f4bf52db445241a",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/kopeninghours-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "recast",
            "config-opts": [
                "-DBUILD_SHARED_LIBS=OFF",
                "-DRECASTNAVIGATION_DEMO=OFF",
                "-DRECASTNAVIGATION_EXAMPLES=OFF",
                "-DRECASTNAVIGATION_TESTS=OFF",
                "-DCMAKE_POSITION_INDEPENDENT_CODE=ON",
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
            ],
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/recastnavigation/recastnavigation/archive/refs/tags/v1.6.0.tar.gz",
                    "sha256": "d48ca0121962fa0639502c0f56c4e3ae72f98e55d88727225444f500775c0074",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 379780,
                        "stable-only": true,
                        "url-template": "https://github.com/recastnavigation/recastnavigation/archive/refs/tags/v$version.tar.gz"
                    }
                }
            ],
            "cleanup": [
                "/lib"
            ]
        },
        {
            "name": "kosmindoormap",
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DCMAKE_DISABLE_FIND_PACKAGE_Protobuf=TRUE"
            ],
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.3/src/kosmindoormap-26.08.3.tar.xz",
                    "sha256": "70f8453cee761778c2cd70a1de1899e797fe9947a616a3c66a2806d2a4e10711",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/kosmindoormap-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "kongress",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.3/src/kongress-26.08.3.tar.xz",
                    "sha256": "a09ea88fb3451c1853ba78e814410f5c113183b328cf51de5401c71fd78adcdc",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 242860,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/kongress-$version.tar.xz"
                    }
                }
            ]
        }
    ]
}
